{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// TypeScript does not apply extension substitution to package.json "imports"
		// wildcard targets, so extensionless #routes/#tests specifiers need paths too.
		"paths": {
			"#routes/*": ["./src/routes/*"],
			"#tests/*": ["./tests/*"]
		}
	},
	"include": ["src", "vite.config.ts", "tests"]
}
